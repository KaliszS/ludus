DATABASE_URL=postgres://ludus:ludus@localhost:5433/ludus

LUDUS_BIND_ADDR=127.0.0.1:8080
LUDUS_LOG=info,ludusd=debug

# openssl rand -base64 48
LUDUS_JWT_SECRET=

# Google OAuth client, type "Web application".
# Redirect URI: https://<instance>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LUDUS_ALLOWED_ORIGINS=http://localhost:5173
LUDUS_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback

# open | approval | closed
LUDUS_REGISTRATION=closed

PUBLIC_DEFAULT_API_URL=http://localhost:8080
