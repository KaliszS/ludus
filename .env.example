DATABASE_URL=postgres://ludus:ludus@localhost:7532/ludus

LUDUS_BIND_ADDR=127.0.0.1:7530
LUDUS_LOG=info,ludusd=debug

# Where this daemon is reachable from outside. The provider redirect is built from
# it, so it must not be taken from the request's Host header.
LUDUS_PUBLIC_URL=http://localhost:7530

# OAuth client of type "Web application". Register this redirect URI with Google:
#   http://localhost:7530/v1/auth/google/callback
LUDUS_GOOGLE_CLIENT_ID=
LUDUS_GOOGLE_CLIENT_SECRET=

LUDUS_ALLOWED_ORIGINS=http://localhost:7531,http://127.0.0.1:7531

# Where a client may be sent after signing in.
LUDUS_ALLOWED_REDIRECT_URIS=http://localhost:7531/auth/callback,http://127.0.0.1:7531/auth/callback

# open | approval | closed
LUDUS_REGISTRATION=closed

PUBLIC_DEFAULT_API_URL=http://localhost:7530
